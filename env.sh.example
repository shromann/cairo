#!/usr/bin/env bash
# =============================================================================
# Cairo — GCP environment configuration EXAMPLE
# Copy this file to env.sh and fill in the <CHANGE_ME> values.
# =============================================================================

export PROJECT_ID="cairo-hack"
export REGION="asia-southeast1"
export BILLING_ACCOUNT="<CHANGE_ME>"         # gcloud billing accounts list

export SQL_INSTANCE="cairo-db"
export SQL_DB="cairo"
export SQL_USER="cairo_app"
export DB_PASSWORD=""                         # generated by infra/04-database.sh
export SQL_CONNECTION=""                      # set after infra/04-database.sh runs

export BUCKET_MEDIA="${PROJECT_ID}-media"
export TOPIC="video-jobs"
export DLQ="video-jobs-dlq"
export REPO="cairo"
